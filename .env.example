# BitChord Telegram Addon — configuration (PRD §4.10-4.11, M6 §7.3)
# Copy to .env and fill in. Never commit the real .env.
#
# M6 resolution order (doc §7.3): encrypted Redis store > env > profile >
# built-ins. The wizard writes the store; env only wins where it is SET.
#
# First boot has two styles — pick ONE:
#   wizard-first (recommended, Render): leave TELEGRAM_* empty. The server
#     boots SETUP and prints `[setup] open .../setup#t=<token>` in the log;
#     the wizard collects credentials and swaps SETUP -> STANDBY -> ACTIVE.
#   env-first (scripted/CI): fill the TELEGRAM_* + TARGET_CHANNEL_IDS block
#     below (generate a session string with `npm run session`); the wizard
#     never opens and the addon boots straight to ACTIVE.

# ---------------------------------------------------------------- secrets (M6, FR-29)
# One 256-bit seed derives EVERYTHING (HKDF): ADDON_SECRET, MEDIA_SIGNING_KEY
# and the config-store key. Prefer this over the separate keys below.
#   openssl rand -base64 32
# NEVER rotate it after first boot: rotating APP_SEED re-derives the whole
# secret family and bricks the stored config until the wizard is re-run.
APP_SEED=
# Explicit overrides — only set these when you do NOT use APP_SEED (legacy
# boot style). Values unrelated to APP_SEED are ignored when a seed is set.
#  ADDON_SECRET      -> openssl rand -hex 24 (32+ chars)
#  MEDIA_SIGNING_KEY -> openssl rand -base64 32
#  CONFIG_KEY        -> openssl rand -base64 32 (config-store cipher key)

# ---------------------------------------------------------------- protocol
# Must be https:// in production (BitChord rejects plain http media URLs).
# On Render PUBLIC_BASE_URL is unnecessary: it falls back to the injected
# RENDER_EXTERNAL_URL. Local http needs ALLOW_INSECURE_BASE_URL=1.
PORT=8080
PUBLIC_BASE_URL=https://your-domain.com
ALLOW_INSECURE_BASE_URL=0

# installer-facing manifest identity (stable across restarts, non-empty id)
ADDON_ID=dev.mystotune.telegram-addon
ADDON_NAME=Telegram Library
ADDON_DESCRIPTION=Streams music from your own Telegram channels

# ---------------------------------------------------------------- telegram
# Leave ALL FOUR empty for wizard-first boot (M6). Fill only for env-first.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Single-use credential: one instance only (FR-20). Wizard-first keeps it in
# the encrypted store instead of a file. Never commit or share it.
TELEGRAM_SESSION_STRING=
# Comma separated channel/chat ids, e.g. -1001234567890,-100987654321
# (wizard-first: chosen in the wizard instead).
TARGET_CHANNEL_IDS=

# ---------------------------------------------------------------- setup & lease (M6)
# SETUP_ENABLED: auto (default) = open while unconfigured; off = never open;
# on = always open at boot when no session is configured.
# SETUP_ENABLED=auto
# PROFILE: render (default when RENDER=true) | vps — tune defaults per host.
# PROFILE=render
# Session lease so two instances never share one Telegram session (doc 7.11):
# acquire SET NX PX ttl; renew every renewMs; self-fence after sustained
# failed renews (~ttl); SIGTERM drains streams for up to drainMs. Defaults:
# LEASE_TTL_MS=45000
# LEASE_RENEW_MS=15000
# LEASE_POLL_MS=5000
# DRAIN_MS=10000
# SESSION_SLOTS=1

# ---------------------------------------------------------------- index / storage
DB_PATH=/data/index.sqlite
# Poll each chat every N minutes (FR-14)
SYNC_INTERVAL_MINUTES=10
# Reconcile deletions every N hours, in batches of 100
RECONCILE_INTERVAL_HOURS=24
# Hard cap on indexed tracks (about 15-25 MB on disk at 50k)
MAX_INDEX_ENTRIES=50000

# ---------------------------------------------------------------- streams
# Byte-streaming concurrency (small host: 2). Extra requests queue, then 503.
MAX_CONCURRENT_STREAMS=2
ADMISSION_WAIT_MS=2000

# ---------------------------------------------------------------- manifest switches (4.9)
ALLOW_DOWNLOADS=1
CHECK_VALID_LOSSLESS=0
# Monthly egress cap in bytes (4.15): default is UNLIMITED (0). Set a number
# for a soft ceiling — exceeding it degrades to plain 404 on completion,
# matching the manifest budget.
# MONTHLY_BYTES_BUDGET=0
# M7.9: off by default — set to 1 for /status to include totalBytes plus a
# per-channel {chatId, count, bytes} breakdown (one SQLite pass per status call).
# TRACK_SIZE_STATS=0

# ---------------------------------------------------------------- runtime
LOG_LEVEL=warn
# Telegram boot auth-failure retries (M5, doc 4.15): AUTH_KEY_DUPLICATED /
# AUTH_KEY_UNREGISTERED handled with backoff before failing the deploy.
# BOOT_AUTH_RETRIES=2
# BOOT_AUTH_RETRY_WAIT_SECONDS=5

# ---------------------------------------------------------------- optional redis (4.11 / M6)
# Leave empty to run with in-process state only (recommended on one instance).
# On Render the Blueprint wires this from the Key Value service automatically.
REDIS_URL=
REDIS_TIMEOUT_MS=200
# Write a compressed index snapshot to Redis after each sync (ephemeral-disk
# hosts only; also seeds /media and cursors on the next boot).
REDIS_SNAPSHOT=0

# ------------------------------------------------------------ render-injected (do NOT set by hand)
# Provided by the platform: PUBLIC_BASE_URL fallback, REDIS_URL wiring,
# RENDER (profile autodetect) and the per-instance lease id below.
# RENDER_EXTERNAL_URL=https://<service>.onrender.com
# RENDER_INSTANCE_ID=<id>

# ------------------------------------------------------------ curation bot (M7.11, SDD-channel-curation-bot)
# Zero-command owner janitor: sweeps the index, sends junk/duplicate review
# cards, executes Delete taps via your own user session. Disabled while
# BOT_TOKEN or BOT_ALLOWED_IDS is empty; the addon runs 100% unchanged.
# BOT_TOKEN=123456:BotFatherToken
# BOT_ALLOWED_IDS=123456789
# Sweep cadence in seconds (60..604800, default daily):
# BOT_SWEEP_SECONDS=86400
