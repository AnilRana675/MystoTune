# BitChord Telegram Addon — configuration (PRD §4.10, §4.11)
# Copy to .env and fill in. Never commit the real .env.
#
#  ADDON_SECRET       -> openssl rand -hex 24
#  MEDIA_SIGNING_KEY  -> openssl rand -base64 32

# ---------------------------------------------------------------- protocol
# Must be https:// in production (BitChord rejects plain http media URLs).
# For local development only: ALLOW_INSECURE_BASE_URL=1 permits
# http://localhost / 127.0.0.1 so the fixture server can be exercised.
PORT=8080
PUBLIC_BASE_URL=https://your-domain.com
ADDON_SECRET=REPLACE_WITH_32_PLUS_RANDOM_CHARS
ALLOW_INSECURE_BASE_URL=0

# installer-facing manifest identity (stable across restarts, non-empty id)
ADDON_ID=dev.mystotune.telegram-addon
ADDON_NAME=Telegram Library
ADDON_DESCRIPTION=Streams music from your own Telegram channels

# ---------------------------------------------------------------- security
# 32+ random bytes, base64 (openssl rand -base64 32)
MEDIA_SIGNING_KEY=REPLACE_WITH_32_PLUS_RANDOM_BYTES
# Media URL TTL in seconds. Default 6 h, well above BitChord's 5 min stream cache.
MEDIA_URL_TTL_SECONDS=21600

# ---------------------------------------------------------------- telegram
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Single-use credential: one instance only (FR-20). Generate with `npm run session`.
TELEGRAM_SESSION_STRING=
# Comma separated channel/chat ids, e.g. -1001234567890,-100987654321
TARGET_CHANNEL_IDS=

# ---------------------------------------------------------------- index / storage
DB_PATH=/data/index.sqlite
# Poll each chat every N minutes (FR-14)
SYNC_INTERVAL_MINUTES=10
# Reconcile deletions every N hours, in batches of 100
RECONCILE_INTERVAL_HOURS=24
# Hard cap on indexed tracks (about 15-25 MB on disk at 50k)
MAX_INDEX_ENTRIES=50000

# ---------------------------------------------------------------- streams
# Byte-streaming concurrency (small host: 2). Extra requests queue, then 503.
MAX_CONCURRENT_STREAMS=2
ADMISSION_WAIT_MS=2000

# ---------------------------------------------------------------- manifest switches (4.9)
ALLOW_DOWNLOADS=1
CHECK_VALID_LOSSLESS=0

# ---------------------------------------------------------------- runtime
LOG_LEVEL=warn

# ---------------------------------------------------------------- optional redis (4.11)
# Leave empty to run with in-process state only (recommended on one instance).
REDIS_URL=
REDIS_TIMEOUT_MS=200
# Write a compressed index snapshot to Redis after each sync (ephemeral-disk hosts only)
REDIS_SNAPSHOT=0
