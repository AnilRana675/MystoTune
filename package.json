{
  "name": "bitchord-telegram-addon",
  "version": "0.6.11-ver",
  "private": true,
  "description": "BitChord addon server that streams audio from your own Telegram chats",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p .",
    "start": "node --disable-warning=ExperimentalWarning --disable-warning=TimeoutNegativeWarning dist/src/server.js",
    "dev": "node --disable-warning=ExperimentalWarning --disable-warning=TimeoutNegativeWarning --import tsx src/server.ts",
    "seed": "tsx scripts/seed-fixture.ts",
    "session": "node scripts/session.mjs",
    "channels": "node scripts/channels.mjs",
    "sync-once": "tsx scripts/sync-once.ts",
    "test": "node --import tsx --test test/contract.test.ts test/range.test.ts test/query.test.ts test/admission.test.ts test/fault.test.ts test/m1.test.ts test/m2.test.ts test/m3.test.ts test/m4.test.ts test/m6.test.ts",
    "soak": "tsx test/soak.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.6.0",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.1",
    "ioredis": "^6.0.0",
    "telegram": "^2.26.22"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.2.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
